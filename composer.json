{
    "name": "sourcetoad/enhanced-resources",
    "description": "Laravel's API Resources enhanced.",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Jason Jones",
            "email": "jason.erik.jones@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sourcetoad\\EnhancedResources\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sourcetoad\\EnhancedResources\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3||^8.4",
        "illuminate/container": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0.0",
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.10"
    },
    "scripts": {
        "check-code": [
            "@lint",
            "@stan",
            "@test"
        ],
        "lint": "@php vendor/bin/pint --test",
        "lint:fix": "@php vendor/bin/pint",
        "stan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit"
    }
}
